# Azure SQL Server Configuration
AZURE_SQL_SERVER=your-azure-sql-server.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USERNAME=your-username
AZURE_SQL_PASSWORD=your-password

# Azure Blob Storage Configuration
AZURE_BLOB_ACCOUNT=your-storage-account
AZURE_BLOB_CONTAINER=your-container-name
AZURE_BLOB_SAS_TOKEN=your-sas-token

# EmailJS Configuration
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID=your-emailjs-template-id

# Server Configuration
PORT=8082

# ==========================================
# IAM LARSIL — identidade única
# Este sistema NÃO tem tabela de usuário e nunca compara senha:
# quem autentica é a IAM. Ver INTEGRACAO.md do projeto iam_larsil.
# ==========================================
IAM_URL=https://painelgestor.up.railway.app
IAM_SISTEMA=REFEICOES

# Chave de auto-registro do sistema + telas na IAM (a TI fornece).
# Sem ela o sistema sobe igual, só não se registra sozinho.
IAM_REGISTRY_KEY=

# true exige a permissão "refeicoes.acesso" para entrar.
# Mantenha false até a TI conceder a permissão aos papéis dos líderes.
IAM_EXIGIR_ACESSO=false

# Painel PCP — resolve a foto de perfil por nome (a IAM não guarda foto)
PCP_URL=https://gestao.up.railway.app

# URL pública deste sistema (informada no auto-registro da IAM)
APP_URL=

# ==========================================
# Z-API — aprovação de pedidos por WhatsApp
# Sem estas variáveis o pedido salva normalmente,
# apenas não dispara a aprovação.
# ==========================================
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
WHATSAPP_APROVADOR=55DDD9XXXXXXXX
NOME_APROVADOR=Elaine Klug

# Segredo do webhook da Z-API. Sem ele o webhook fica DESLIGADO
# (nunca aberto). Vai na URL: /api/webhook/zapi?segredo=...
ZAPI_WEBHOOK_SEGREDO=

# ==========================================
# TELEGRAM — aprovação de pedidos (long-polling, sem webhook)
# Crie o bot com @BotFather e cole o token aqui.
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USER=
TELEGRAM_CHAT_APROVADOR=

# Senha para se registrar como aprovador: /start <SENHA> no bot.
# Sem ela, qualquer um que ache o bot vira aprovador de gasto.
TELEGRAM_SENHA_REGISTRO=

# Quem pode clicar em APROVAR/REPROVAR, por id do Telegram,
# separado por virgula. VAZIO = qualquer pessoa do chat registrado.
# Use quando o bot estiver num grupo com gente que nao deve aprovar.
TELEGRAM_APROVADORES=
